# Supply-chain hardening for the frontend dependency tree.
#
# Rationale (audited 2026-08-16: 32 direct deps, 406 lockfile entries, all
# sha512-pinned, all from registry.npmjs.org, 382/382 registry signatures
# verified, 91 with provenance attestations, 0 deprecated, 0 vulnerabilities).

# Block lifecycle scripts (preinstall/install/postinstall) from DEPENDENCIES.
# This is the primary remote-code-execution vector in an npm compromise: a
# malicious release runs arbitrary code on the build host at install time,
# before any of its code is ever imported.
#
# Verified safe for this tree: exactly one package declares an install script —
# `fsevents` (dev-only, macOS-only, optional peer of the file watcher), which is
# not installed on Linux CI/build hosts anyway.
#
# This does NOT block `npm run <script>`; our own build/test/lint scripts still
# run normally. It only suppresses automatic lifecycle scripts.
ignore-scripts=true

# Pin the registry explicitly so a stray environment variable, a user-level
# ~/.npmrc, or an inherited CI setting cannot silently redirect resolution to a
# proxy or mirror.
registry=https://registry.npmjs.org/

# `npm audit` fails the build only on high/critical. Moderate findings in the
# dev toolchain are reported but do not block — they carry no production
# exposure (nothing in devDependencies ships in the bundle).
audit-level=high

fund=false
