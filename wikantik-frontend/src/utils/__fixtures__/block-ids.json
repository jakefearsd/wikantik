[
  { "name": "inline marker on a paragraph", "markdown": "Alpha beta ^abc\n",
    "expected": [ { "tag": "p", "id": "^abc", "text": "Alpha beta" } ] },
  { "name": "inline marker after emphasis", "markdown": "Para *em* ^e\n",
    "expected": [ { "tag": "p", "id": "^e", "text": "Para em" } ] },
  { "name": "marker inside emphasis is not one", "markdown": "Para *em ^e*\n",
    "expected": [ { "tag": "p", "id": null, "text": "Para em ^e" } ] },
  { "name": "escaped caret is not a marker", "markdown": "Para \\^esc\n",
    "expected": [ { "tag": "p", "id": null, "text": "Para ^esc" } ] },
  { "name": "list item inline marker", "markdown": "- one ^a1\n- two\n",
    "expected": [ { "tag": "li", "id": "^a1", "text": "one" }, { "tag": "li", "id": null, "text": "two" } ] },
  { "name": "task list item", "markdown": "- [ ] task one\n- [x] task two ^tk\n",
    "expected": [ { "tag": "li", "id": null, "text": "task one" }, { "tag": "li", "id": "^tk", "text": "task two" } ] },
  { "name": "nested list item", "markdown": "- top ^t1\n  - nested ^n1\n- second\n",
    "expected": [ { "tag": "li", "id": "^t1", "text": "top nested" }, { "tag": "li", "id": "^n1", "text": "nested" },
                  { "tag": "li", "id": null, "text": "second" } ] },
  { "name": "last-line marker after a soft break", "markdown": "Para\n^ll\n",
    "expected": [ { "tag": "p", "id": "^ll", "text": "Para" } ] },
  { "name": "last-line marker after a hard break", "markdown": "Para  \n^hb\n",
    "expected": [ { "tag": "p", "id": "^hb", "text": "Para" } ] },
  { "name": "last-line marker after a multi-line paragraph", "markdown": "Line one\nline two\n^ml\n",
    "expected": [ { "tag": "p", "id": "^ml", "text": "Line one line two" } ] },
  { "name": "last-line marker in a list item", "markdown": "- Item\n  ^li\n",
    "expected": [ { "tag": "li", "id": "^li", "text": "Item" } ] },
  { "name": "standalone marker after a blank line tags the paragraph", "markdown": "Para\n\n^sa\n",
    "expected": [ { "tag": "p", "id": "^sa", "text": "Para" } ] },
  { "name": "standalone marker in a loose list item", "markdown": "- item\n\n  ^lp\n",
    "expected": [ { "tag": "li", "id": "^lp", "text": "item" }, { "tag": "p", "id": null, "text": "item" } ] },
  { "name": "standalone marker on a table", "markdown": "| a | b |\n|---|---|\n| 1 | 2 |\n\n^tbl\n",
    "expected": [ { "tag": "table", "id": "^tbl", "text": "" } ] },
  { "name": "standalone marker on a quote", "markdown": "> quoted\n\n^q\n",
    "expected": [ { "tag": "blockquote", "id": "^q", "text": "" }, { "tag": "p", "id": null, "text": "quoted" } ] },
  { "name": "standalone marker inside a quote", "markdown": "> a\n>\n> ^qa\n",
    "expected": [ { "tag": "p", "id": "^qa", "text": "a" } ] },
  { "name": "standalone marker on a list", "markdown": "- x\n\n^l\n",
    "expected": [ { "tag": "ul", "id": "^l", "text": "" }, { "tag": "li", "id": null, "text": "x" } ] },
  { "name": "standalone marker on an ordered list", "markdown": "1. x\n2. y\n\n^ol\n",
    "expected": [ { "tag": "ol", "id": "^ol", "text": "" }, { "tag": "li", "id": null, "text": "x" },
                  { "tag": "li", "id": null, "text": "y" } ] },
  { "name": "standalone marker on fenced code", "markdown": "```\ncode ^no\n```\n\n^cd\n",
    "expected": [ { "tag": "pre", "id": "^cd", "text": "" } ] },
  { "name": "standalone marker on fenced code with a language", "markdown": "```java\nint x;\n```\n\n^jv\n",
    "expected": [ { "tag": "pre", "id": "^jv", "text": "" } ] },
  { "name": "standalone marker on indented code", "markdown": "    indented ^no\n\n^ic\n",
    "expected": [ { "tag": "pre", "id": "^ic", "text": "" } ] },
  { "name": "standalone marker on display math", "markdown": "$$\nx ^no\n$$\n\n^m\n",
    "expected": [ { "tag": "div", "id": "^m", "text": "" } ] },
  { "name": "standalone marker on a math fence", "markdown": "```math\ny\n```\n\n^mf\n",
    "expected": [ { "tag": "div", "id": "^mf", "text": "" } ] },
  { "name": "standalone marker on a callout", "markdown": "> [!note] T\n> body\n\n^c1\n",
    "expected": [ { "tag": "div", "id": "^c1", "text": "" }, { "tag": "p", "id": null, "text": "body" } ] },
  { "name": "standalone marker on a folded callout", "markdown": "> [!tip]- T\n> body\n\n^c2\n",
    "expected": [ { "tag": "details", "id": "^c2", "text": "" }, { "tag": "p", "id": null, "text": "body" } ] },
  { "name": "inline marker in a callout body", "markdown": "> [!note] T\n> body ^cb\n",
    "expected": [ { "tag": "p", "id": "^cb", "text": "body" } ] },
  { "name": "orphan standalone marker", "markdown": "^lone\n\nText\n",
    "expected": [ { "tag": "span", "id": "^lone", "text": "" }, { "tag": "p", "id": null, "text": "Text" } ] },
  { "name": "orphan in a list item", "markdown": "- ^oi\n",
    "expected": [ { "tag": "li", "id": null, "text": "" }, { "tag": "span", "id": "^oi", "text": "" } ] },
  { "name": "heading caret stays literal", "markdown": "## T ^h\n\nBody\n",
    "expected": [ { "tag": "p", "id": null, "text": "Body" } ] },
  { "name": "code span holds no marker", "markdown": "Use `x ^c`\n",
    "expected": [ { "tag": "p", "id": null, "text": "Use x ^c" } ] },
  { "name": "inline math holds no marker", "markdown": "Sum $a ^b$\n",
    "expected": [ { "tag": "p", "id": null, "text": "Sum" } ] },
  { "name": "inline math before a marker", "markdown": "Sum $a$ then ^im\n",
    "expected": [ { "tag": "p", "id": "^im", "text": "Sum then" } ] },
  { "name": "whitespace rule", "markdown": "x^2 and 2^10 and e^x\n",
    "expected": [ { "tag": "p", "id": null, "text": "x^2 and 2^10 and e^x" } ] },
  { "name": "duplicate ids: the first wins", "markdown": "a ^d\n\nb ^d\n\n^d\n",
    "expected": [ { "tag": "p", "id": "^d", "text": "a" }, { "tag": "p", "id": null, "text": "b" } ] },
  { "name": "duplicate orphan gets no anchor", "markdown": "^dd\n\n^dd\n\nText ^dd\n",
    "expected": [ { "tag": "span", "id": "^dd", "text": "" }, { "tag": "p", "id": null, "text": "Text" } ] },
  { "name": "ids are case-sensitive", "markdown": "a ^Ab\n\nb ^ab\n",
    "expected": [ { "tag": "p", "id": "^Ab", "text": "a" }, { "tag": "p", "id": "^ab", "text": "b" } ] },
  { "name": "CRLF line endings", "markdown": "Alpha ^abc\r\n\r\n- x ^k\r\n\r\nPara\r\n^ll\r\n\r\n> q\r\n\r\n^cq\r\n",
    "expected": [ { "tag": "p", "id": "^abc", "text": "Alpha" }, { "tag": "li", "id": "^k", "text": "x" },
                  { "tag": "p", "id": "^ll", "text": "Para" }, { "tag": "blockquote", "id": "^cq", "text": "" },
                  { "tag": "p", "id": null, "text": "q" } ] },
  { "name": "access-rule paragraph is not a block", "markdown": "First.\n\n[{ALLOW view Admin}]\n\n^ar\n",
    "expected": [ { "tag": "p", "id": "^ar", "text": "First." } ] },
  { "name": "standalone after only an access rule is an orphan", "markdown": "[{ALLOW view Admin}]\n\n^ro\n\nText\n",
    "expected": [ { "tag": "span", "id": "^ro", "text": "" }, { "tag": "p", "id": null, "text": "Text" } ] },
  { "name": "embed-only paragraph with an inline marker", "markdown": "![[BlockIdParityEmbed]] ^em\n",
    "pages": [ "BlockIdParityEmbed" ],
    "expected": [ { "tag": "div", "id": "^em", "text": "" } ] },
  { "name": "embed-only paragraph with a last-line marker", "markdown": "![[BlockIdParityEmbed]]\n^em2\n",
    "pages": [ "BlockIdParityEmbed" ],
    "expected": [ { "tag": "div", "id": "^em2", "text": "" } ] },
  { "name": "standalone marker on a rendered fence", "markdown": "```mermaid\ngraph TD; A-->B\n```\n\n^fg\n",
    "expected": [ { "tag": "figure", "id": "^fg", "text": "" } ] }
]
