  { "name": "embed-only paragraph with a last-line marker", "markdown": "![[BlockIdParityEmbed]]\n^em2\n",
    "pages": [ "BlockIdParityEmbed" ],
    "expected": [ { "tag": "div", "id": "^em2", "text": "" } ] },
  { "name": "standalone marker on a rendered fence", "markdown": "```mermaid\ngraph TD; A-->B\n```\n\n^fg\n",
    "expected": [ { "tag": "figure", "id": "^fg", "text": "" } ] },
  { "name": "reviewer: marker on a paragraph whose next line is a rule", "markdown": "Para ^id\n[{ALLOW view Admin}]\n\nAfter.\n",
    "expected": [ { "tag": "p", "id": "^id", "text": "Para" }, { "tag": "p", "id": null, "text": "After." } ] },
  { "name": "reviewer: marker then a rule on the same line", "markdown": "Para ^id [{ALLOW view Admin}]\n",
    "expected": [ { "tag": "p", "id": "^id", "text": "Para" } ] },
  { "name": "reviewer: list item marker with a rule on its continuation line", "markdown": "- item ^id\n  [{ALLOW view Admin}]\n",
    "expected": [ { "tag": "li", "id": "^id", "text": "item" } ] },
  { "name": "reviewer: quote marker with a rule on the next quote line", "markdown": "> quote ^q\n> [{ALLOW view Admin}]\n",
    "expected": [ { "tag": "p", "id": "^q", "text": "quote" } ] },
  { "name": "reviewer: last-line marker before a rule", "markdown": "Para.\n^id [{DENY edit Guest}]\n",
    "expected": [ { "tag": "p", "id": "^id", "text": "Para." } ] },
  { "name": "reviewer: last-line marker, rule on the line after", "markdown": "Para.\n^id\n[{DENY edit Guest}]\n",
    "expected": [ { "tag": "p", "id": "^id", "text": "Para." } ] },
  { "name": "reviewer: setext underline under a stripped rule", "markdown": "Para.\n\n[{ALLOW view Admin}]\n===\n\nAfter ^x\n",
    "expected": [ { "tag": "p", "id": null, "text": "Para." }, { "tag": "p", "id": null, "text": "===" },
                  { "tag": "p", "id": "^x", "text": "After" } ],
    "editor": { "expected": [ { "tag": "p", "id": null, "text": "Para." }, { "tag": "p", "id": "^x", "text": "After" } ],
      "why": "The preview draws the raw buffer, where the rule is the text of a setext heading; the reader strips the rule first and shows === as a paragraph. Ids agree; the block picker numbers the heading's place differently (local only, never sent to the server)." } },
  { "name": "reviewer: a tab between a rule and a marker", "markdown": "Para.\n\n[{ALLOW view Admin}]\t^id\n\nAfter.\n",
    "expected": [ { "tag": "p", "id": null, "text": "Para." }, { "tag": "p", "id": null, "text": "After." } ],
    "editor": { "expected": [ { "tag": "p", "id": null, "text": "Para." }, { "tag": "p", "id": null, "text": "^id" },
                              { "tag": "p", "id": null, "text": "After." } ],
      "why": "The preview draws the raw buffer: the rule's line stays a paragraph (with its chip); the reader strips the rule first, which leaves the line indented, so code. No id either side." } },
  { "name": "reviewer: four spaces between a rule and a marker", "markdown": "Para.\n\n[{ALLOW view Admin}]    ^id\n\nAfter.\n",
    "expected": [ { "tag": "p", "id": null, "text": "Para." }, { "tag": "p", "id": null, "text": "After." } ],
    "editor": { "expected": [ { "tag": "p", "id": null, "text": "Para." }, { "tag": "p", "id": null, "text": "^id" },
                              { "tag": "p", "id": null, "text": "After." } ],
      "why": "As for a tab: the preview keeps the rule's paragraph, the reader shows code. No id either side." } },
  { "name": "reviewer: an indented rule and two spaces", "markdown": "Para.\n\n  [{ALLOW view Admin}]  ^id\n\nAfter.\n",
    "expected": [ { "tag": "p", "id": null, "text": "Para." }, { "tag": "p", "id": null, "text": "After." } ],
    "editor": { "expected": [ { "tag": "p", "id": null, "text": "Para." }, { "tag": "p", "id": null, "text": "^id" },
                              { "tag": "p", "id": null, "text": "After." } ],
      "why": "As for a tab: the preview keeps the rule's paragraph, the reader shows code. No id either side." } },
  { "name": "reviewer: an indented marker after a rule line", "markdown": "Para.\n\n[{ALLOW view Admin}]\n    ^id\n\nAfter.\n",
    "expected": [ { "tag": "p", "id": null, "text": "Para." }, { "tag": "p", "id": null, "text": "After." } ],
    "editor": { "expected": [ { "tag": "p", "id": null, "text": "Para." }, { "tag": "p", "id": null, "text": "^id" },
                              { "tag": "p", "id": null, "text": "After." } ],
      "why": "In the raw buffer the indented line continues the rule's paragraph; the reader strips the rule line first and shows code. No id either side." } },
  { "name": "reviewer: a vertical tab after a marker beside a rule", "markdown": "Para.\n\n[{ALLOW view Admin}] ^id\u000b\n\nAfter.\n",
    "expected": [ { "tag": "p", "id": null, "text": "Para." }, { "tag": "p", "id": null, "text": "^id" },
                  { "tag": "p", "id": null, "text": "After." } ] },
  { "name": "reviewer: a rule line inside a quote paragraph", "markdown": "> quote\n[{ALLOW view Admin}]\n> body ^i\n",
    "expected": [ { "tag": "p", "id": "^i", "text": "quote body" } ] }
]
