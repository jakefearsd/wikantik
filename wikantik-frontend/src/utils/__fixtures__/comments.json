[
  {"name": "inline comment is removed", "input": "a %%hidden%% b", "output": "a  b"},
  {"name": "two comments on a line", "input": "a %%1%% b %%2%% c", "output": "a  b  c"},
  {"name": "a comment spanning lines keeps its newlines", "input": "a %%x\ny\nz%% b", "output": "a \n\n b"},
  {"name": "an empty comment is removed", "input": "x%%%%y", "output": "xy"},
  {"name": "a comment holding a backtick", "input": "a %%it`s%% b `c`", "output": "a  b `c`"},
  {"name": "text with no comment is unchanged", "input": "plain text, 100% sure", "output": "plain text, 100% sure"},
  {"name": "a single percent pair is not a comment", "input": "a % b % c", "output": "a % b % c"},
  {"name": "an unterminated comment stays literal", "input": "a %%b", "output": "a %%b"},
  {"name": "an unterminated comment after a closed one", "input": "a %%x%% b %%c", "output": "a  b %%c"},
  {"name": "inside a code span", "input": "`%%x%%` and %%y%%", "output": "`%%x%%` and "},
  {"name": "inside a double-backtick code span", "input": "``a %%x%% b`` z", "output": "``a %%x%% b`` z"},
  {"name": "inside a fenced block", "input": "```\n%%x%%\n```\n%%y%% z", "output": "```\n%%x%%\n```\n z"},
  {"name": "a mermaid comment inside a mermaid fence", "input": "```mermaid\ngraph TD\n%% a mermaid comment\nA-->B\n```\n", "output": "```mermaid\ngraph TD\n%% a mermaid comment\nA-->B\n```\n"},
  {"name": "inside a tilde fence", "input": "~~~\n%% keep %%\n~~~", "output": "~~~\n%% keep %%\n~~~"},
  {"name": "inside inline math", "input": "$a %%b%% c$ d %%e%%", "output": "$a %%b%% c$ d "},
  {"name": "inside block math (a LaTeX comment)", "input": "$$\nx = 1 %% tex\ny = 2 %%\n$$\n%%gone%%", "output": "$$\nx = 1 %% tex\ny = 2 %%\n$$\n"},
  {"name": "a comment around inline math", "input": "%% $x$ %%after", "output": "after"},
  {"name": "a comment on its own line leaves the empty line", "input": "line one\n%%note%%\nline two", "output": "line one\n\nline two"}
]
