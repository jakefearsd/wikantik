[
  { "name": "simple", "markdown": "#foo", "html": "<p><a class=\"tag inline-tag\" href=\"/search?tag=foo\">#foo</a></p>", "tags": ["foo"] },
  { "name": "case is normalised, text is as written", "markdown": "#Foo", "html": "<p><a class=\"tag inline-tag\" href=\"/search?tag=foo\">#Foo</a></p>", "tags": ["foo"] },
  { "name": "nested tag flattens in the href only", "markdown": "#a/b", "html": "<p><a class=\"tag inline-tag\" href=\"/search?tag=a-b\">#a/b</a></p>", "tags": ["a-b"] },
  { "name": "in a sentence with punctuation", "markdown": "see #foo, and #bar.", "html": "<p>see <a class=\"tag inline-tag\" href=\"/search?tag=foo\">#foo</a>, and <a class=\"tag inline-tag\" href=\"/search?tag=bar\">#bar</a>.</p>", "tags": ["foo", "bar"] },
  { "name": "a colour in prose is a tag", "markdown": "use #fff here", "html": "<p>use <a class=\"tag inline-tag\" href=\"/search?tag=fff\">#fff</a> here</p>", "tags": ["fff"] },
  { "name": "digits only is text", "markdown": "issue #123", "html": "<p>issue #123</p>", "tags": [] },
  { "name": "digits then a letter is a tag", "markdown": "#123a", "html": "<p><a class=\"tag inline-tag\" href=\"/search?tag=123a\">#123a</a></p>", "tags": ["123a"] },
  { "name": "glued to a word is text", "markdown": "x#foo", "html": "<p>x#foo</p>", "tags": [] },
  { "name": "unicode letters are percent-encoded in the href", "markdown": "#café", "html": "<p><a class=\"tag inline-tag\" href=\"/search?tag=caf%C3%A9\">#café</a></p>", "tags": ["café"] },
  { "name": "in a list item", "markdown": "- #foo", "html": "<ul><li><a class=\"tag inline-tag\" href=\"/search?tag=foo\">#foo</a></li></ul>", "tags": ["foo"] },
  { "name": "heading marker is not a tag", "markdown": "# Heading", "html": "<h1>Heading</h1>", "tags": [] },
  { "name": "a heading line is skipped whole", "markdown": "## H #x", "html": "<h2>H #x</h2>", "tags": [] },
  { "name": "inside a code span", "markdown": "`#x`", "html": "<p><code>#x</code></p>", "tags": [] },
  { "name": "inside a fenced block", "markdown": "```\n#x\n```", "html": "<pre><code>#x\n</code></pre>", "tags": [] },
  { "name": "inside inline math", "markdown": "$#x$", "noTag": true, "tags": [] },
  { "name": "inside block math", "markdown": "$$\n#x\n$$", "noTag": true, "tags": [] },
  { "name": "a url fragment", "markdown": "https://e.com/#frag", "noTag": true, "tags": [] },
  { "name": "a wikilink heading anchor", "markdown": "[[Page#Heading]]", "noTag": true, "tags": [] },
  { "name": "a link destination fragment", "markdown": "[t](#frag)", "noTag": true, "tags": [] },
  { "name": "inside link text is not a nested link", "markdown": "[see #foo](x)", "noTag": true, "indexOnly": true, "tags": ["foo"] },
  { "name": "inside a comment", "markdown": "a %% #x %% b", "noTag": true, "tags": [] },
  { "name": "after a comment", "markdown": "%% #x %% #y", "html": "<p><a class=\"tag inline-tag\" href=\"/search?tag=y\">#y</a></p>", "tags": ["y"] },
  { "name": "escaped hash is text", "markdown": "\\#foo", "html": "<p>#foo</p>", "tags": [] },
  { "name": "glued to emphasis is text", "markdown": "**#foo**", "html": "<p><strong>#foo</strong></p>", "tags": [] }
]
