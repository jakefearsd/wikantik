<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

  <parent>
    <groupId>com.wikantik.it</groupId>
    <artifactId>wikantik-it-tests</artifactId>
    <version>2.4.5-SNAPSHOT</version>
  </parent>

  <artifactId>wikantik-it-test-dense</artifactId>
  <modelVersion>4.0.0</modelVersion>
  <packaging>war</packaging>
  <name>Wikantik IT :: dense retrieval</name>
  <description>Integration tests for dense retrieval and the RAG context bundle against a live CPU embedding provider — the only IT module with embeddings enabled</description>

  <properties>
    <it-wikantik.context>${project.artifactId}</it-wikantik.context>

    <it-wikantik.groupdatabase>com.wikantik.auth.authorize.JDBCGroupDatabase</it-wikantik.groupdatabase>
    <it-wikantik.userdatabase>com.wikantik.auth.user.JDBCUserDatabase</it-wikantik.userdatabase>
    <it-wikantik.referenceStyle>relative</it-wikantik.referenceStyle>

    <!--
      Port of the shared CPU embedder the IT phase starts. bin/run-tests.sh owns the
      value and passes it as -Dit.embed.port, which overrides this; the literal here is
      the fallback for a direct `mvn -pl ... -Pintegration-tests` invocation. From this
      one property it reaches BOTH consumers — the deployed wiki's
      wikantik.search.embedding.base-url (resource filtering) and DenseBundleIT's
      readiness probe (failsafe systemPropertyVariables, below) — so the two can never
      end up pointing at different endpoints.

      Deliberately NOT 11434: that is the developer's own dev embedder, and a test run
      that silently borrowed it would depend on ambient machine state.
    -->
    <it.embed.port>11435</it.embed.port>
  </properties>

  <build>
    <!--
      This module ships its OWN wikantik-custom.properties (the only one in the
      repo that points at a live embedder). The parent integration-tests profile
      points resources at the shared wikantik-selenide-tests file; overriding
      here with combine.self="override" replaces that list instead of appending,
      so the embeddings-enabled config is unambiguously the one on the classpath.

      COPYING THIS BLOCK? Note what else the override drops. The shared
      wikantik-selenide-tests/src/main/resources directory is not just
      wikantik-custom.properties — it also holds junit-platform.properties (the
      JUnit 5 parallel-execution config for the Selenide browser suite) and
      wikantik-mcp.properties. Overriding the resource list removes ALL of them
      from this module's classpath, not only the file being replaced.

      Both omissions are deliberate and benign here: DenseBundleIT is a plain
      HTTP client suite with no @Execution(CONCURRENT) opt-in, so without
      junit-platform.properties JUnit's sequential default is exactly what it
      already wanted; and there are no MCP tests here, so McpConfig's jar
      defaults are fine. A module that runs Selenide classes, or that opts into
      concurrent execution, must add those files back rather than inherit this.
    -->
    <resources combine.self="override">
      <resource>
        <directory>${project.basedir}/src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>properties-maven-plugin</artifactId>
      </plugin>

      <!-- Activates the parent pluginManagement reserve-it-ports execution
           (dynamic it.db.port / it.wikantik.servlet.port / it.wikantik.rmi.port)
           so this module is parallel-safe. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>io.fabric8</groupId>
        <artifactId>docker-maven-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
      </plugin>

      <plugin>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <!-- Do NOT scan the selenide tests dependency — this module has its own tests
               and no browser/MCP suites. -->
          <dependenciesToScan combine.self="override" />
          <includes>
            <include>**/*IT.java</include>
          </includes>
          <systemPropertyVariables>
            <it-wikantik.base.url>http://localhost:${it.wikantik.servlet.port}/${it-wikantik.context}</it-wikantik.base.url>
            <it.db.user>${it.db.user}</it.db.user>
            <it.db.password>${it.db.password}</it.db.password>
            <it.db.port>${it.db.port}</it.db.port>
            <it.db.name>${it.db.name}</it.db.name>
            <!-- Same source as the deployed wiki's embedding base-url — see it.embed.port above. -->
            <it.embed.port>${it.embed.port}</it.embed.port>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.codehaus.cargo</groupId>
        <artifactId>cargo-maven3-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <!-- JSON parsing for REST response validation -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
