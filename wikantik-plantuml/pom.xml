<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

  <parent>
    <groupId>com.wikantik</groupId>
    <artifactId>wikantik-builder</artifactId>
    <version>2.5.3</version>
  </parent>

  <modelVersion>4.0.0</modelVersion>
  <artifactId>wikantik-plantuml</artifactId>
  <name>Wikantik PlantUML (shaded, Ditaa stripped)</name>

  <properties>
    <!-- JaCoCo line-coverage floor; measured 98.4% after the hostile-input/gap tests, pinned at the 0.90 cap -->
    <wikantik.coverage.line.minimum>0.90</wikantik.coverage.line.minimum>
  </properties>

  <dependencies>
    <!-- optional: never transitive. The shaded wikantik-plantuml jar carries the classes
         (minus Ditaa, which is LGPL); consumers must not see the unshaded artifact. -->
    <dependency>
      <groupId>net.sourceforge.plantuml</groupId>
      <artifactId>plantuml-mit</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <shadedArtifactAttached>false</shadedArtifactAttached>
              <minimizeJar>false</minimizeJar>
              <artifactSet>
                <includes>
                  <include>net.sourceforge.plantuml:plantuml-mit</include>
                </includes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>net.sourceforge.plantuml:plantuml-mit</artifact>
                  <excludes>
                    <!-- Ditaa is LGPL: must never ship -->
                    <exclude>org/stathissideris/**</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <!-- The standard library is ~17 MB of icon sets the policy never lets a diagram include: keep only
                         C4 (the one allowed !include <C4/...>) and the library index. -->
                    <exclude>%regex[stdlib/(?!c4/|home[.]spm$).+]</exclude>
                  </excludes>
                </filter>
                <filter>
                  <!-- The Apache resource bundle's generic NOTICE would describe the bundled PlantUML/Smetana code as
                       ASF Apache-2.0 code; it is replaced by src/main/shade/NOTICE below. -->
                  <artifact>com.wikantik:wikantik-plantuml</artifact>
                  <excludes>
                    <exclude>META-INF/NOTICE</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                  <resource>META-INF/NOTICE</resource>
                  <file>src/main/shade/NOTICE</file>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
