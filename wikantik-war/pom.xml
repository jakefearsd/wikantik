<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <parent>
        <groupId>com.wikantik</groupId>
        <artifactId>wikantik-builder</artifactId>
        <version>2.4.19-SNAPSHOT</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <artifactId>wikantik-war</artifactId>
    <name>Wikantik Main War</name>
    <packaging>war</packaging>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>wikantik-main</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>wikantik-mcp-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>wikantik-admin-mcp</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>wikantik-tools</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>wikantik-scim</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>wikantik-knowledge</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>wikantik-observability</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Content intelligence. wikantik-rest declares this 'provided' like its other
             siblings, so the jar reaches WEB-INF/lib only through this entry. Without it the
             context fails to start with NoClassDefFoundError at deploy time — compile and unit
             tests both pass, because the class is on the compile classpath either way. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>wikantik-insights</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>wikantik-rest</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-layout-template-json</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- SSO support: pac4j OIDC (optional in jspwiki-main, required at runtime) -->
        <dependency>
            <groupId>org.pac4j</groupId>
            <artifactId>pac4j-oidc</artifactId>
        </dependency>

        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- PostgreSQL driver is provided by Tomcat's lib/ directory -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- On classpath so SystemPageRegistry can discover system page names at startup -->
        <dependency>
            <groupId>com.wikantik.wikipages</groupId>
            <artifactId>wikantik-wikipages-en</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Required because the parent surefire argLine references
             ${org.mockito:mockito-core:jar}; the property is only populated
             when mockito-core is on the module's dependency tree. -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>Wikantik</finalName>
        <plugins>
            <!-- Build React frontend (npm install + npm run build) -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>frontend-npm-install</id>
                        <phase>generate-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <!-- `ci`, NOT `install`. This is the artifact that ships, so it must
                                 be reproducible: `npm ci` installs package-lock.json exactly and
                                 fails if the lock and package.json disagree. `npm install` would
                                 re-resolve every caret range at build time, so a malicious patch
                                 release published after the last lockfile update would be pulled
                                 silently into the production bundle, across 406 transitive
                                 packages. The ignore-scripts flag additionally blocks dependency
                                 lifecycle scripts (the install-time RCE vector); only `fsevents`
                                 declares one here, and it is dev/macOS-only. -->
                            <executable>npm</executable>
                            <workingDirectory>${project.basedir}/../wikantik-frontend</workingDirectory>
                            <arguments>
                                <argument>ci</argument>
                                <argument>--no-audit</argument>
                                <argument>--no-fund</argument>
                                <argument>--ignore-scripts</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>frontend-npm-build</id>
                        <phase>generate-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <!-- `npm run build`, NOT `npx vite build`. npx will silently DOWNLOAD
                                 a package from the registry when it cannot resolve one locally —
                                 turning a broken install into an unpinned fetch. `npm run` only
                                 ever executes node_modules/.bin, so it fails loudly instead. -->
                            <executable>npm</executable>
                            <workingDirectory>${project.basedir}/../wikantik-frontend</workingDirectory>
                            <!-- Bake the Maven version into the SPA bundle (vite reads
                                 process.env.WIKANTIK_VERSION → __APP_VERSION__ → footer). -->
                            <environmentVariables>
                                <WIKANTIK_VERSION>${project.version}</WIKANTIK_VERSION>
                            </environmentVariables>
                            <arguments>
                                <argument>run</argument>
                                <argument>build</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <artifactId>maven-war-plugin</artifactId>
                <configuration>
                    <webResources>
                        <!-- React SPA frontend — served at / -->
                        <resource>
                            <directory>${project.basedir}/../wikantik-frontend/dist</directory>
                        </resource>
                    </webResources>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <!-- Unpack the JSP Wiki Pages -->
                    <execution>
                        <id>unpack-wikipages-private</id>
                        <phase>package</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.wikantik.wikipages</groupId>
                                    <artifactId>wikantik-wikipages-en</artifactId>
                                    <version>${project.version}</version>
                                </artifactItem>
                            </artifactItems>
                            <excludes>META-INF/**</excludes>
                            <outputDirectory>${project.build.directory}/wikantik/data/wikantik-files</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
