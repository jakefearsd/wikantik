{
  "name": "create_item",
  "description": "Create a work item. It is always created as a draft with no assignee, for a person to refine; status and assignee are refused by name. Optionally a type and labels. Returns {key,version,status}. Use handoff_item afterwards to give it to someone.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "project": {
        "type": "string",
        "description": "The project key.",
        "examples": [
          "PLAT"
        ]
      },
      "level": {
        "type": "string",
        "description": "epic, story or task.",
        "examples": [
          "task"
        ]
      },
      "title": {
        "type": "string",
        "description": "The title.",
        "examples": [
          "Retry failed uploads"
        ]
      },
      "body": {
        "type": "string",
        "description": "The body, Markdown source.",
        "examples": [
          "Why and what."
        ]
      },
      "parentKey": {
        "type": "string",
        "description": "The parent item\u0027s key.",
        "examples": [
          "PLAT-2"
        ]
      },
      "productKey": {
        "type": "string",
        "description": "The product\u0027s key. Omit it to use the project\u0027s default product; pass an empty string for none.",
        "examples": [
          "web"
        ]
      },
      "kind": {
        "type": "string",
        "description": "software (default), docs or admin.",
        "examples": [
          "software"
        ]
      },
      "type": {
        "type": "string",
        "description": "feature (default), bug or chore; an epic is always a feature.",
        "examples": [
          "bug"
        ]
      },
      "labels": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Labels: lowercase letters, digits, dots, dashes and underscores, at most 10. The whole set is replaced.",
        "examples": [
          [
            "ui",
            "billing"
          ]
        ]
      },
      "priority": {
        "type": "integer",
        "description": "1 (highest) to 4.",
        "examples": [
          3
        ]
      },
      "queue": {
        "type": "string",
        "description": "The queue key to put it in.",
        "examples": [
          "implementer"
        ]
      }
    },
    "required": [
      "project",
      "level",
      "title"
    ]
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false
  }
}
